%% CarePoint Pharmacy — database schema (simple version, for review)
%% Django DRF + PostgreSQL.
%% Relationship legend:  ||--o{  one to many   |o--o{  optional one to many

erDiagram
    ADMIN_USERS {
        int id PK "Django built-in user table"
        varchar username UK
        varchar password "unused, login is email + OTP"
        varchar first_name
        varchar last_name
        varchar email UK "used to log in"
        bool is_active
        bool is_superuser "Django built-in, not used for roles yet"
        timestamp last_login
        timestamp date_joined
    }

    ORDERS {
        bigint id PK "auto number from 1001, shown to customer as order no."
        varchar customer_name
        varchar customer_phone "required, stored as +923001234567"
        varchar order_type "new_prescription | refill"
        varchar method "pickup | delivery"
        text delivery_address "as typed by customer, empty for pickup"
        text notes "optional"
        varchar status "received | confirmed | ready | out_for_delivery | completed | cancelled"
        timestamp created_at
        timestamp updated_at
    }

    PRESCRIPTIONS {
        bigint id PK "auto number from 1, shown to customer as prescription no."
        varchar file_path "uploaded photo or PDF in file storage"
        timestamp created_at
    }

    ORDER_PRESCRIPTIONS {
        int id PK
        bigint order_id FK
        bigint prescription_id FK
        timestamp created_at
    }

    STORE_SETTINGS {
        int id PK "always 1, edits update this same row"
        varchar name
        varchar phone
        text address
        int years_serving "shown on website"
        int avg_refill_minutes "shown on website"
        int updated_by FK "last admin who edited"
        timestamp updated_at
    }

    OPENING_HOURS {
        int id PK
        smallint day_of_week UK "0 Sunday to 6 Saturday"
        time opens_at
        time closes_at
        bool is_closed
        int updated_by FK "last admin who edited"
        timestamp updated_at
    }

    ADMIN_LOGIN_CODES {
        int id PK
        int admin_id FK
        varchar code_hash "6-digit code, stored scrambled"
        timestamp expires_at "10 minutes after created"
        smallint attempts "cancelled after 5 wrong tries"
        timestamp used_at "empty until used, works once"
        timestamp created_at
    }

    ORDERS ||--o{ ORDER_PRESCRIPTIONS : "includes"
    PRESCRIPTIONS ||--o{ ORDER_PRESCRIPTIONS : "used in"
    ADMIN_USERS |o--o{ STORE_SETTINGS : "last edited by"
    ADMIN_USERS |o--o{ OPENING_HOURS : "last edited by"
    ADMIN_USERS ||--o{ ADMIN_LOGIN_CODES : "requests"

%% Login: admin enters email, gets a code (terminal in development, email in production),
%% then stays logged in with JWT: 15-minute access token + 14-day refresh token in a secure cookie.
%% JWT logout blacklist tables are created automatically by djangorestframework-simplejwt.
