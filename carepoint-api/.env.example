# Copy to .env and fill in. Never commit .env (it holds passwords).
# Values below are for the PRODUCTION server; your laptop's .env differs where noted.

DEBUG=false                       # laptop: true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=carepoint.pk,www.carepoint.pk     # laptop: localhost,127.0.0.1
DATABASE_URL=postgres://carepoint:PASSWORD@localhost:5432/carepoint   # laptop: port 5434

# Where uploaded prescriptions are stored. Must NOT be served by Nginx.
MEDIA_ROOT=/srv/carepoint/media

# IMPORTANT behind Nginx: exactly 1. With 0 every visitor looks the same and shares one
# rate limit; with 2+ visitors could fake their address and skip rate limits.
# Nginx must also send:  proxy_set_header X-Forwarded-For $remote_addr;
#                        proxy_set_header X-Forwarded-Proto $scheme;
# and Django (Gunicorn) must only listen on 127.0.0.1 or a unix socket.
NUM_PROXIES=1                     # laptop: 0

# Login code emails. laptop: EMAIL_MODE=terminal (codes are printed in the terminal)
EMAIL_MODE=smtp
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CarePoint Pharmacy <noreply@carepoint.pk>

# Optional rate limits (defaults shown)
# THROTTLE_ORDERS=10/hour
# THROTTLE_LOGIN_REQUEST=5/hour
# THROTTLE_LOGIN_VERIFY=20/hour

# Phone alerts for staff (web push). Leave empty to turn them off.
# Make a key pair once with:  .venv/bin/python manage.py make_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
